APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sanad_teacher_v2
DB_USER=root
DB_PASS=

# Required. Generate with: php -r "echo bin2hex(random_bytes(32));"
# The app refuses to start in production (APP_ENV=production) if this is missing
# or shorter than 32 characters.
JWT_SECRET=
JWT_TTL=172800
JWT_TTL_REMEMBER=2592000

# Required. Generate with: php -r "echo bin2hex(random_bytes(32));"
# The app refuses to start in production (APP_ENV=production) if this is missing
# or shorter than 32 characters.
CSRF_SECRET=

COOKIE_NAME=sanad_auth_token
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax

ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=300

TRUSTED_PROXIES=
