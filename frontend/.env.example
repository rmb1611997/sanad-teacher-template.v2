# VITE_API_URL — base URL prepended to every API call in src/services/apiClient.ts.
#
# Leave EMPTY in both development and production: the app is designed to call
# the backend via a relative path on the same origin (Vite dev proxy locally,
# Nginx reverse-proxy in production — see backend/deploy/nginx.conf). The auth
# cookie is SameSite=Lax and will not be sent on a cross-site request, so the
# frontend and backend must stay same-origin unless that cookie/CORS setup is
# deliberately changed.
#
# No secrets belong in this file or any VITE_* variable — everything here is
# bundled into the client-side JS and is publicly visible in the browser.
VITE_API_URL=
